\f0\b\fs48 \cf0 20. Payment Validation Checklist\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Before activating an account, the Cloud Function must verify:\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Payment identity\
\pard\pardeftab720\partightenfactor0

\f4\b0\fs26 \cf0 \
payment_id\
invoice_id\
order_id\
\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Payment status\
\pard\pardeftab720\partightenfactor0

\f4\b0\fs26 \cf0 \
payment_status === "finished"\
\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Currency/asset\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Confirm that the received payment corresponds to the expected payment asset.\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Amount\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Confirm that the amount received satisfies the order's payment requirements.\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Ownership\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Confirm:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
payment.order_id\
        
\f5 \uc0\u8595 
\f4 \
our orders/\{orderId\}\
        
\f5 \uc0\u8595 
\f4 \
order.userId\
\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Parent payment\
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 Check:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
parent_payment_id\
\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 This is particularly important because NOWPayments documents repeated deposits and warns that repeated deposits may not correspond cleanly to the original expected amount.\
\pard\pardeftab720\partightenfactor0
\cf3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 21. 
\f6\fs52 partially_paid
\f0\fs48 \
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 This state requires special handling.\
If:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
payment_status = partially_paid\
\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 then:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
payment.internalStatus = "underpaid"\
\
order.status = "payment_underpaid"\
\
user.accountStatus = "pending_payment"\
\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Do not activate the account.
\f2\b0 \
NOWPayments explicitly recommends against automatically providing goods/services when the payment is partially paid, especially when receiving the full amount is important.\
\pard\pardeftab720\partightenfactor0
\cf3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 22. 
\f6\fs52 failed
\f0\fs48 \
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 If:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
payment_status = failed\
\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 then:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
payment.internalStatus = "failed"\
\
order.status = "payment_failed"\
\
user.accountStatus = "pending_payment"\
\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 The customer can initiate another payment attempt.\
\pard\pardeftab720\partightenfactor0
\cf3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 23. 
\f6\fs52 expired
\f0\fs48 \
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 If:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
payment_status = expired\
\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 then:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
payment.internalStatus = "expired"\
\
order.status = "payment_expired"\
\
user.accountStatus = "pending_payment"\
\
\pard\pardeftab720\sa240\partightenfactor0

\f2\fs24 \cf0 The original payment attempt is closed.\
The user can create a new payment attempt.\
The user account itself should not automatically be deleted simply because a payment attempt expired.\
\pard\pardeftab720\partightenfactor0
\cf3 \
\pard\pardeftab720\sa321\partightenfactor0

\f0\b\fs48 \cf0 24. 
\f6\fs52 refunded
\f0\fs48 \
\pard\pardeftab720\sa240\partightenfactor0

\f2\b0\fs24 \cf0 If a completed payment later becomes:\
\pard\pardeftab720\partightenfactor0

\f4\fs26 \cf0 \
refunded\
\
